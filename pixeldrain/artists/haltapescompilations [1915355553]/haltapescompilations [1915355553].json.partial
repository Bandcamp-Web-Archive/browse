        {
            "url": "https://halmcgee.bandcamp.com/album/connection-cassette-compilation-3",
            "title": "Connection Cassette Compilation #3",
            "artist": "various",
            "label": null,
            "band_id": 647004872,
            "classification": "paid",
            "tags": [

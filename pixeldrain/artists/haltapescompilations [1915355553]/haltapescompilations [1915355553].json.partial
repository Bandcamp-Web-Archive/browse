            "band_id": 647004872,
            "classification": "paid",
            "tags": [
                "Experimental",
                "electronic",
                "improvisation",
                "noise",
                "tape collage",
                "Gainesville"
            ],
            "item_id": 2426820854,
            "art_id": 45067465,
            "is_preorder": false,
            "datePublished": "13 Aug 2023 00:00:00 GMT",
            "about": "Chance Encounters in the City is a compilation of short sound works inspired by the idea of an imagined “chance encounter” with an artist or a source of artistic inspiration in a real or fictional city. The concept for this compilation was inspired by Lumen K’s real-life chance encounter with artists Hal McGee and Girls on Fire in the Bowery district of New York City, as pictured on the cover.\nCompilation produced by Lumen K.\nContributors should direct message Trevor to receive free download codes.",
            "credits": "released August 13, 2023",
            "license": "all rights reserved",
            "coverUrl_0": "https://f4.bcbits.com/img/a0045067465_0",
            "trackinfo": [
                {

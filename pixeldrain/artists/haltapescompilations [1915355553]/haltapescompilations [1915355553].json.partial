                {
                    "title": "dear police stop fighting the occupiers",
                    "duration": "01:00",
                    "lyrics": null,
                    "label": null,
                    "track_id": 1039187382,
                    "track_num": "20",
                    "artist": "Subversive Intentions (USA)",
                    "url": "https://halmcgee.bandcamp.com/track/dear-police-stop-fighting-the-occupiers",
                    "trackCoverUrl_0": "https://f4.bcbits.com/img/a1231220116_0",
                    "art_id": 1231220116,
                    "about": "The track was composed to feature a couple scraps of metal that I found while walking through the back of my girl friends property in the woods. I was also testing out my new contact mics from crank sturgeon. I layered over this a looped vocal drone, an instrument I made out of a coffee can and a rubber band, as well as a sample from a video of a soldier at the Occupy Times Square protest. He very passionately argues with the police to stop harming innocent protesters. This video was played for me by the members of the Oklahoma folk bands Luna Moth and Blue Valley Farmer a day after they played a show at my house. The video can be found here:  www.youtube.com/watch?v=WmEHcOc0Sys",
                    "credits": "from Contact Compilation 1, track released October 19, 2011\nSubversive Intentions\nBrunswick, Maine, USA\nsubversive.intentions@gmail.com\nsubversiveintentions.wordpress.com\nsound collage, field recording, improv\nI like to mix the sound of trash with the sound of the human voice",
                    "license": "Attribution Non-commercial No Derivatives"
                },

                {
                    "title": "Multi-hued Carpenter Wounds",
                    "duration": "01:00",
                    "lyrics": null,
                    "label": null,
                    "track_id": 1617406310,
                    "track_num": "49",
                    "artist": "John Dunlap (USA)",
                    "url": "https://halmcgee.bandcamp.com/track/multi-hued-carpenter-wounds",
                    "trackCoverUrl_0": "https://f4.bcbits.com/img/a3015427877_0",
                    "art_id": 3015427877,
                    "about": "Multi-hued Carpenter Wounds is a glitch etude exploring the possibilities for forcing the audio editing program Super Collider to play huge streams of notes at immense speed. Each layer of the composition is the same algorithmic chord progression, with different \"mistakes\" placed in to cause Super Collider to stutter. The Wave of violence toward the middle of the track is the program trying to play the algorithm back with each note lasting only 0.00034 of a second. The resultant timbre has somewhere in the realm of 10,000 simultaneous notes.",
                    "credits": "from Contact Compilation 1, track released October 20, 2011\nJohn Dunlap (Hug0-n07)\nBrooklyn, New York.\nwww.johndunlapjazz.com\nfreejazztampa@yahoo.com\nsonicvomit.blogspot.com\nexperimental electronic music\nw/ command line software, hardware hacking\nJazz Guitar\nMongolian Throat Singing",
                    "license": "Attribution Non-commercial No Derivatives"
                },
